<?xml version="1.0" encoding="UTF-8"?>
<!-- What GNOME Software, KDE Discover and `flatpak search` show for the app.
     The release at the bottom is filled in from the deb's resources at build
     time, so the version listed always matches what was packaged. -->
<component type="desktop-application">
  <id>com.anycubic.AnycubicSlicer</id>

  <name>Anycubic Slicer Next</name>
  <summary>Prepare 3D models for printing on Anycubic FDM printers</summary>

  <developer id="com.anycubic">
    <name>Anycubic</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <!-- The deb ships only the AGPL-3.0 text, but it also bundles closed-source
       libraries (libcloud_*.so, libMachMQTT.so, libWorkbench.so, ...) with no
       published source and no license of their own. -->
  <project_license>AGPL-3.0-only AND LicenseRef-proprietary</project_license>

  <description>
    <p>
      Anycubic Slicer Next is the slicer Anycubic publishes for its FDM 3D printers.
      It is based on OrcaSlicer, Bambu Studio and PrusaSlicer, and adds Anycubic printer
      profiles, LAN and cloud printing, and multi-color (ACE) support.
    </p>
    <p>
      This is an unofficial package. It repackages the Ubuntu 24.04 .deb that Anycubic
      publishes and is not affiliated with or supported by Anycubic. Please report
      packaging problems to the packaging project, not to Anycubic.
    </p>
  </description>

  <launchable type="desktop-id">com.anycubic.AnycubicSlicer.desktop</launchable>

  <url type="homepage">https://github.com/develonrails/anycubic-slicer-next</url>
  <url type="bugtracker">https://github.com/develonrails/anycubic-slicer-next/issues</url>

  <categories>
    <category>Graphics</category>
    <category>3DGraphics</category>
    <category>Engineering</category>
  </categories>

  <keywords>
    <keyword>3D printing</keyword>
    <keyword>slicer</keyword>
    <keyword>gcode</keyword>
    <keyword>Anycubic</keyword>
    <keyword>Kobra</keyword>
  </keywords>

  <provides>
    <mediatype>model/stl</mediatype>
    <mediatype>model/3mf</mediatype>
    <mediatype>application/vnd.ms-3mfdocument</mediatype>
    <mediatype>application/prs.wavefront-obj</mediatype>
    <mediatype>application/x-amf</mediatype>
  </provides>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <!-- The app has an account login and reports usage to Anycubic. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>

  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
